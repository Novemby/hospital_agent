# Copy these entries into .env.local; never commit the real Key.
# Base URL is the API root ending in /v1 where required, NOT /embeddings.
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_TIMEOUT=30
RAG_EMBEDDING_MAX_RETRIES=2

# Optional: fall back to OPENAI_API_KEY / OPENAI_BASE_URL / LC_MODEL if omitted.
RAG_CHAT_BASE_URL=https://api.deepseek.com
RAG_CHAT_MODEL=deepseek-chat
RAG_CHAT_API_KEY=
RAG_CHAT_TIMEOUT=30
RAG_CHAT_MAX_RETRIES=1
